<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.1.0 GIT</Version>
  <Author>LuckyGoose</Author>
 </Creator>
 <Manufacturer>Cosmos</Manufacturer>
 <Model>FP1210 Flat Par Can</Model>
 <Type>Color Changer</Type>
 <Channel Name="Master dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red dimmer" Preset="IntensityRed"/>
 <Channel Name="Green dimmer" Preset="IntensityGreen"/>
 <Channel Name="Blue dimmer" Preset="IntensityBlue"/>
 <Channel Name="White dimmer" Preset="IntensityWhite"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="10" Preset="ShutterOpen">Stobe open</Capability>
  <Capability Min="11" Max="255" Preset="StrobeSlowToFast">Strobe speed</Capability>
 </Channel>
 <Channel Name="Macro">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="9">Manual dimming for CH1-6</Capability>
  <Capability Min="10" Max="50">Colour selection</Capability>
  <Capability Min="51" Max="100">Chase</Capability>
  <Capability Min="101" Max="150">Gradient</Capability>
  <Capability Min="151" Max="200" Preset="PulseSlowToFast">Pulse</Capability>
  <Capability Min="201" Max="220">Sound Control Mode 1</Capability>
  <Capability Min="221" Max="230">Sound Control Mode 2</Capability>
  <Capability Min="231" Max="240">Sound Control Mode 3</Capability>
  <Capability Min="241" Max="255">Sound Control Mode 4</Capability>
 </Channel>
 <Channel Name="Speed">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Speed of selected macro</Capability>
 </Channel>
 <Mode Name="4 channels">
  <Channel Number="0">Red dimmer</Channel>
  <Channel Number="1">Green dimmer</Channel>
  <Channel Number="2">Blue dimmer</Channel>
  <Channel Number="3">White dimmer</Channel>
 </Mode>
 <Mode Name="8 channels">
  <Channel Number="0">Master dimmer</Channel>
  <Channel Number="1">Red dimmer</Channel>
  <Channel Number="2">Green dimmer</Channel>
  <Channel Number="3">Blue dimmer</Channel>
  <Channel Number="4">White dimmer</Channel>
  <Channel Number="5">Strobe</Channel>
  <Channel Number="6">Macro</Channel>
  <Channel Number="7">Speed</Channel>
  <Head>
   <Channel>0</Channel>
   <Channel>1</Channel>
   <Channel>2</Channel>
   <Channel>3</Channel>
   <Channel>4</Channel>
   <Channel>5</Channel>
   <Channel>6</Channel>
   <Channel>7</Channel>
  </Head>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="1.2" Width="250" Height="105" Depth="250"/>
  <Lens Name="Other" DegreesMin="40" DegreesMax="40"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="70" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
