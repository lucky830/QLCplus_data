<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.0.1</Version>
  <Author>LuckyGoose</Author>
 </Creator>
 <Manufacturer>EUROLITE</Manufacturer>
 <Model>TMH-155 Moving-Head</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Preset="PositionPan"/>
 <Channel Name="Tilt" Preset="PositionTilt"/>
 <Channel Name="Color">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="15">Open / White</Capability>
  <Capability Min="16" Max="31" Preset="ColorMacro" Res1="#ff00ff">Pink</Capability>
  <Capability Min="32" Max="47" Preset="ColorMacro" Res1="#0000ff">Blue</Capability>
  <Capability Min="48" Max="63" Preset="ColorMacro" Res1="#ff9900">Orange</Capability>
  <Capability Min="64" Max="79" Preset="ColorMacro" Res1="#00ff00">Green</Capability>
  <Capability Min="80" Max="95" Preset="ColorMacro" Res1="#9900ff">Violet</Capability>
  <Capability Min="96" Max="111" Preset="ColorMacro" Res1="#ffff00">Yellow</Capability>
  <Capability Min="112" Max="127" Preset="ColorMacro" Res1="#ffff00">Red</Capability>
  <Capability Min="128" Max="255" Preset="ColorWheelIndex">Rainbow (slow to fast)</Capability>
 </Channel>
 <Channel Name="Gobo rotation">
  <Group Byte="0">Gobo</Group>
  <Capability Min="0" Max="127">Gobo indexing</Capability>
  <Capability Min="128" Max="189">Forwards gobo rotation with decreasing speed</Capability>
  <Capability Min="190" Max="193">No rotation</Capability>
  <Capability Min="194" Max="255">Backwards gobo rotation with increasing speed</Capability>
 </Channel>
 <Channel Name="Rotating gobo-wheel">
  <Group Byte="0">Gobo</Group>
  <Capability Min="0" Max="31" Preset="GoboMacro" Res1="Others/open.svg">Open</Capability>
  <Capability Min="32" Max="63" Preset="GoboMacro">Gobo 1</Capability>
  <Capability Min="64" Max="95" Preset="GoboMacro">Gobo 2</Capability>
  <Capability Min="96" Max="127" Preset="GoboMacro">Gobo 3</Capability>
  <Capability Min="128" Max="159" Preset="GoboMacro">Gobo 4</Capability>
  <Capability Min="160" Max="191" Preset="GoboMacro">Gobo 5</Capability>
  <Capability Min="192" Max="223" Preset="GoboMacro">Gobo 6</Capability>
  <Capability Min="224" Max="255" Preset="GoboMacro">Gobo 7</Capability>
 </Channel>
 <Channel Name="Shutter">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="39" Preset="ShutterClose">Shutter closed</Capability>
  <Capability Min="40" Max="128">Dimmer control (shutter open)</Capability>
  <Capability Min="129" Max="139" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="140" Max="243" Preset="StrobeSlowToFast">Strobe</Capability>
  <Capability Min="244" Max="255">No function</Capability>
 </Channel>
 <Mode Name="Normal (6 ch)">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Tilt</Channel>
  <Channel Number="2">Color</Channel>
  <Channel Number="3">Gobo rotation</Channel>
  <Channel Number="4">Rotating gobo-wheel</Channel>
  <Channel Number="5">Shutter</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="12" Width="330" Height="380" Depth="315"/>
  <Lens Name="Other" DegreesMin="13" DegreesMax="13"/>
  <Focus Type="Head" PanMax="360" TiltMax="250"/>
  <Technical PowerConsumption="265" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
