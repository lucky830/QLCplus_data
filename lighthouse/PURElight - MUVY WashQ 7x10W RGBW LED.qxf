<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.0.1</Version>
  <Author>LuckyGoose</Author>
 </Creator>
 <Manufacturer>PURElight</Manufacturer>
 <Model>MUVY WashQ 7x10W RGBW LED</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Preset="PositionPan"/>
 <Channel Name="Pan fine" Preset="PositionPanFine"/>
 <Channel Name="Tilt" Preset="PositionTilt"/>
 <Channel Name="Tilt fine" Preset="PositionTiltFine"/>
 <Channel Name="Pan/Tilt Speed" Preset="SpeedPanTiltSlowFast"/>
 <Channel Name="Red dimmer" Preset="IntensityRed"/>
 <Channel Name="Green dimmer" Preset="IntensityGreen"/>
 <Channel Name="Blue dimmer" Preset="IntensityBlue"/>
 <Channel Name="White dimmer" Preset="IntensityWhite"/>
 <Channel Name="Color macro">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="7">Color Choice</Capability>
  <Capability Min="8" Max="231">Macro colors</Capability>
  <Capability Min="232" Max="255">Color Change, rapid</Capability>
 </Channel>
 <Channel Name="Color change &#10;speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Color change speed</Capability>
 </Channel>
 <Channel Name="Modes">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="7">Manual mode</Capability>
  <Capability Min="8" Max="63">Automatic mode, fast</Capability>
  <Capability Min="64" Max="127">Automatic mode, slow</Capability>
  <Capability Min="128" Max="191">Sound control 1</Capability>
  <Capability Min="192" Max="255">Sound control 2</Capability>
 </Channel>
 <Channel Name="Reset">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="150" Max="200">reset</Capability>
 </Channel>
 <Channel Name="shutter">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="7">Shutter close</Capability>
  <Capability Min="8" Max="134">dimmer</Capability>
  <Capability Min="135" Max="239" Preset="StrobeSlowToFast">Strobe</Capability>
  <Capability Min="240" Max="255" Preset="ShutterOpen">Shutter open</Capability>
 </Channel>
 <Mode Name="9 channel">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Tilt</Channel>
  <Channel Number="2">shutter</Channel>
  <Channel Number="3">Red dimmer</Channel>
  <Channel Number="4">Green dimmer</Channel>
  <Channel Number="5">Blue dimmer</Channel>
  <Channel Number="6">White dimmer</Channel>
  <Channel Number="7">Pan/Tilt Speed</Channel>
  <Channel Number="8">Reset</Channel>
  <Head>
   <Channel>0</Channel>
   <Channel>1</Channel>
   <Channel>2</Channel>
   <Channel>3</Channel>
   <Channel>4</Channel>
   <Channel>5</Channel>
   <Channel>6</Channel>
   <Channel>7</Channel>
   <Channel>8</Channel>
  </Head>
 </Mode>
 <Mode Name="14 channel">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Pan fine</Channel>
  <Channel Number="2">Tilt</Channel>
  <Channel Number="3">Tilt fine</Channel>
  <Channel Number="4">Pan/Tilt Speed</Channel>
  <Channel Number="5">shutter</Channel>
  <Channel Number="6">Red dimmer</Channel>
  <Channel Number="7">Green dimmer</Channel>
  <Channel Number="8">Blue dimmer</Channel>
  <Channel Number="9">White dimmer</Channel>
  <Channel Number="10">Color macro</Channel>
  <Channel Number="11">Color change 
speed</Channel>
  <Channel Number="12">Modes</Channel>
  <Channel Number="13">Reset</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="3" Width="220" Height="260" Depth="270"/>
  <Lens Name="Other" DegreesMin="45" DegreesMax="45"/>
  <Focus Type="Head" PanMax="570" TiltMax="270"/>
  <Technical PowerConsumption="80" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
